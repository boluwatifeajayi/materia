# Copy to .env and fill in. .env is gitignored and never read from disk by the
# package: keys are read from the environment only.

# Dev loop provider. Free tier, used for iteration only. Groq run numbers are
# never reported as results. See docs/ARCHITECTURE.md section 9.
GROQ_API_KEY=

# Scored runs only: T12, T19, T20, T21. Needed before T12.
ANTHROPIC_API_KEY=

# groq | anthropic. Read once at startup.
MATERIA_PROVIDER=groq
